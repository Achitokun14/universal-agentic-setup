  "notes": "Agent registry for universal-agentic-setup. One entry per verified agent from the 2026 agent landscape research. Paths are user-scope; '~' expands to the home directory, '{appdata}' to the Windows roaming AppData dir. 'context.files' lists the file(s) that receive the core/AGENTS.md managed block. 'mcp.format' references a renderer in scripts/agentic_sync.py. 'manual': true = at least one config path/format is unverified or not safely mergeable stdlib-only, so the sync prints instructions instead of writing. Env entries anywhere in this repo carry variable NAMES only.",
  "formats": {
    "claude-json": "top-level mcpServers object in ~/.claude.json (Claude Code user scope)",
    "mcpservers-json": "JSON file whose root (or mcpServers key) holds {name: {command,args,env}} entries",
    "serverurl-json": "mcpServers-style JSON where remote servers use 'serverUrl' (Antigravity/Windsurf requirement)",
    "codex-toml": "[mcp_servers.<id>] TOML tables in ~/.codex/config.toml",
    "opencode-json": "'mcp' key with type local|remote entries in opencode.json",
    "zed-json": "'context_servers' key with nested command objects in Zed settings.json",
    "amp-json": "'amp.mcpServers' nested object in ~/.config/amp/settings.json",
    "crush-json": "'mcp' key with string command entries in ~/.config/crush/config.json"
  },
